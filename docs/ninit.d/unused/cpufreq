#!/usr/bin/env lua
#%depon: modules-load
#%onfail: warn
local governor = "schedutil"
for cpu = 0, 4095 do
	local path = "/sys/devices/system/cpu/cpu" .. cpu .. "/cpufreq/scaling_governor"
	local f = io.open(path, "w")
	if not f then
		break
	end
	f:write(governor)
	local ok, err = f:close()
	if not ok then
		io.stderr:write("cpufreq: ", path, ": ", err, "\n")
		os.exit(1)
	end
end
