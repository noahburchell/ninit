#!/bin/bash
#%depon: tmpfiles-dev
#%type: daemon
#%notify: 3
#%restart: always

for u in /usr/lib/systemd/systemd-udevd /lib/systemd/systemd-udevd /sbin/udevd; do
	[ -x "$u" ] && udevd="$u" && break
done
[ -n "$udevd" ] || { echo "udev: no udevd binary found" >&2; exit 1; }

{
	SECONDS=0
	while ((SECONDS < 15)); do
		if udevadm control --ping --timeout=1 >/dev/null 2>&1; then
			echo >&3
			exit 0
		fi
		sleep 0.05
	done
	echo "udev: no ping reply in 15s, reporting it up unverified" >&2
	echo >&3
} &

exec 3>&- "$udevd"
