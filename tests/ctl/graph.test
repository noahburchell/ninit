# dependency resolution, ordering and derived columns, README 3.5, 3.6 and 4.1

. "$top_srcdir/tests/lib.sh"

# writes TEXT as the service NAME in DIR
put() {
	mkdir -p "$1"
	printf '%b' "$3" >"$1/$2"
}

build() {
	run "$NINITCTL" init -d "$1" --no-check "${@:2}"
}

# the show row of NAME without the index, from the graph in DIR
row() {
	"$NINITCTL" show "$1/depgraph" | sed -n "s/^ *[0-9][0-9]*  \($2 .*\)/\1/p" | sed 's/ *$//'
}

order() {
	"$NINITCTL" show "$1/depgraph" | awk '/^ *[0-9]+  /{ printf "%s ", $2 }' | sed 's/ $//'
}

d=$T/missing
put "$d" a '#%depon: ghost\n:\n'
build "$d"
t_is "$rc" 1 "a prerequisite that names no service fails the build"
t_has "$err" "ninitctl: $d/a: depon:ghost names no service in $d" "and names it"

d=$T/missing-of
put "$d" a '#%depof: ghost\n:\n'
build "$d"
t_has "$err" "ninitctl: $d/a: depof:ghost names no service in $d" "a missing depof is reported the same way"

d=$T/self
put "$d" a '#%depon: a\n:\n'
build "$d"
t_is "$rc" 1 "a service depending on itself fails the build"
t_has "$err" "ninitctl: $d/a: depends on itself" "and says so"

d=$T/self-of
put "$d" a '#%depof: a\n:\n'
build "$d"
t_has "$err" "ninitctl: $d/a: depends on itself" "depof on itself is caught too"

d=$T/cyc2
put "$d" a '#%depon: b\n:\n'
put "$d" b '#%depon: a\n:\n'
build "$d"
t_is "$rc" 1 "a two service cycle fails the build"
t_has "$err" $'ninitctl: dependency cycle:\n  ' "the cycle is announced"
t_like "$err" $'\n  (a -> b -> a|b -> a -> b)$' "and printed as a -> b -> a"

d=$T/cyc3
put "$d" a '#%depon: b\n:\n'
put "$d" b '#%depon: c\n:\n'
put "$d" c '#%depon: a\n:\n'
put "$d" x '#%depon: a\n:\n'
build "$d"
t_is "$rc" 1 "a three service cycle fails the build"
cyc=$(tail -n1 <<<"$err")
t_like "$cyc" '^  ([abc]) -> [abc] -> [abc] -> \1$' "the whole cycle is printed, closing on its start"
t_unlike "$cyc" 'x' "a service hanging off the cycle is not part of it"

d=$T/cyc-of
put "$d" a '#%depof: b\n:\n'
put "$d" b '#%depof: a\n:\n'
build "$d"
t_has "$err" "dependency cycle" "a cycle made of depof is found"

d=$T/cyc-mixed
put "$d" a '#%depon: b\n:\n'
put "$d" c '#%depof: b\n#%depon: a\n:\n'
put "$d" b ':\n'
build "$d"
t_has "$err" "dependency cycle" "a cycle mixing depon and depof is found"
[ ! -e "$d/depgraph" ]
t_ok $? "a cycle writes no graph"

# roots first, then the longest chain of dependents, then the name
d=$T/order
put "$d" z ':\n'
put "$d" y '#%depon: z\n:\n'
put "$d" x '#%depon: y\n:\n'
put "$d" m ':\n'
put "$d" n '#%depon: m\n:\n'
put "$d" a ':\n'
put "$d" c ':\n'
build "$d"
t_is "$rc" 0 "the order graph builds"
t_has "$out" ": 7 services, 3 edges, 4 roots," "4 roots and 3 edges are counted"
t_is "$(order "$d")" "z m a c y n x" "roots by chain length then name, then the rest the same way"

d=$T/order2
put "$d" a ':\n'
put "$d" q '#%depon: a\n:\n'
put "$d" b ':\n'
put "$d" t '#%depon: b\n'
put "$d" u '#%depon: t\n:\n'
build "$d"
t_is "$(order "$d")" "b a t q u" "a longer chain of dependents comes before an earlier name"

# lvl and kills
d=$T/cols
put "$d" fs ':\n'
put "$d" mounts '#%depon: fs\n:\n'
put "$d" udev ':\n'
put "$d" basic '#%depon: mounts udev\n'
put "$d" getty '#%depon: basic\n#%type: daemon\n#%restart: always\nexec sleep 1\n'
put "$d" lone ':\n'
build "$d"
t_like "$(row "$d" fs)" '^fs +oneshot +1 +3 +stop ' "fs: level 1, 3 services depend on it, onfail stop"
t_like "$(row "$d" mounts)" '^mounts +oneshot +2 +2 +stop .* fs$' "mounts: level 2, kills 2"
t_like "$(row "$d" udev)" '^udev +oneshot +1 +2 +stop ' "udev: level 1, kills 2"
t_like "$(row "$d" basic)" '^basic +target +3 +1 +stop .* udev mounts$' "basic: level 3, kills 1, prerequisites in index order"
t_like "$(row "$d" getty)" '^getty +daemon +4 +0 +warn +- +yes +basic$' "getty: level 4, nothing depends on it, onfail warn"
t_like "$(row "$d" lone)" '^lone +oneshot +1 +0 +warn ' "a root with no dependents defaults to onfail warn"
run "$NINITCTL" show "$d/depgraph"
t_has "$out" "6 services, 4 edges, 3 roots, 4 levels," "the summary counts levels"
t_has "$out" $'deepest dependency chain (4 services)\n  fs -> mounts -> basic -> getty' "the deepest chain is printed"

# onfail resolution
d=$T/warn-deps
put "$d" a '#%onfail: warn\n:\n'
put "$d" b '#%depon: a\n:\n'
build "$d"
t_is "$rc" 1 "onfail warn with a dependent fails the build"
t_has "$err" "ninitctl: $d/a: onfail:warn but 1 service depends on it" "and counts it"
put "$d" c '#%depon: b\n:\n'
build "$d"
t_has "$err" "ninitctl: $d/a: onfail:warn but 2 services depend on it" "transitive dependents count, in the plural"

d=$T/onfail
put "$d" a '#%onfail: shell\n:\n'
put "$d" b '#%onfail: stop\n:\n'
put "$d" c '#%depon: a\n#%onfail: warn\n:\n'
build "$d"
t_like "$(row "$d" a)" ' shell ' "onfail shell is kept"
t_like "$(row "$d" b)" ' stop ' "onfail stop is kept on a service without dependents"
t_like "$(row "$d" c)" ' warn ' "onfail warn is valid without dependents"

# readiness warning
d=$T/vague
put "$d" d1 '#%type: daemon\nexec sleep 1\n'
put "$d" d2 '#%type: daemon\nexec sleep 1\n'
put "$d" d3 '#%type: daemon\n#%notify: 3\nexec sleep 1\n'
put "$d" d4 '#%type: daemon\nexec sleep 1\n'
put "$d" u '#%depon: d1 d3\n:\n'
build "$d"
t_has "$err" "ninitctl: warning: 1 daemon with dependents has no notify:, their dependents start on exec, not on readiness" \
	"a daemon with dependents and no notify is warned about"
t_has "$err" $'\nninitctl:   d1' "by name"
t_unlike "$err" 'ninitctl:   d[234]' "daemons with notify or without dependents are not listed"
put "$d" v '#%depon: d2\n:\n'
build "$d"
t_has "$err" "ninitctl: warning: 2 daemons with dependents have no notify:" "the warning is plural for two"
t_is "$rc" 0 "the warning does not fail the build"

# a target is a root when it has no prerequisites, and is listed as a target
d=$T/target
put "$d" t ''
put "$d" a '#%depon: t\n:\n'
build "$d"
t_is "$rc" 0 "an empty file is a target"
t_like "$(row "$d" t)" '^t +target +1 +1 +stop ' "a target may be a root"

t_done
