total = 1 + \
        2 + \
    3
values = [
    1,   # one
        2,
  # a comment line inside brackets
    3,
]
config = {
    "a": (1,
          2),   # tuple
    "b": [x
          for x in range(3)
          if x],
}

@staticmethod
def deco(f):
    return f

def call(a,
         b = 2,   # default
         *args,
         **kw):
    return a + b + sum(args) + sum(kw.values())

result = call(1,
              2,
              3, z = 4)
match result:
    case 10:   # matched
        print("ten")
    case _:
        print("other", result)
