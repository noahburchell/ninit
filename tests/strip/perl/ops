#!/usr/bin/perl
use strict;
use warnings;
my ($a, $b) = (7, 2);
my %h = (n => 10);
my @arr = (4, 6);
my $ref = \%h;
print $a / $b, " ", ($a + 1) / 2, " ", $h{n} / 5, " ", $ref->{n} / 2, " ", $arr[1] / 3, "\n";
my $d = undef;
print $d // "default", "\n";
my $i = 3;
$i++;
print $i / 2, "\n";
print -e "/" ? "root exists\n" : "no root\n";
print "ok\n" unless $a < $b or $b > $a * 10;
my @sorted = sort { $a <=> $b } (3, 1, 2);
print "@sorted\n";
my $s = sprintf("%d%%", 50);
print "$s\n";
print "matched\n" if "abc" =~ /b/ and "abc" !~ /z/;
