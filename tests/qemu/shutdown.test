# the shutdown sequence, README 7.2

. "$top_srcdir/tests/lib.sh"
. "$top_srcdir/tests/qemu/lib.sh"
q_require

# a daemon that logs SIGTERM and exits, with optional prerequisite and deps
trapper() {
	q_svc "$1" <<EOF
#%type: daemon
${2:+#%depon: $2}
${3:+#%deps: $3}
trap 'echo "STOP \$0 \$EPOCHREALTIME"; exit 0' TERM
while :; do sleep 0.05; done
EOF
}

q_new shutdown
Q_TIMEOUT=90
trapper s1
trapper s2 s1
trapper s3 s2
trapper p1 "" order
trapper p2 p1
trapper lone
q_svc stubborn <<'EOF'
#%type: daemon
#%depon: s1
#%stop-timeout: 1s
trap '' TERM
while :; do sleep 0.05; done
EOF
q_svc again <<'EOF'
#%type: daemon
#%restart: always
exec sleep 1000
EOF
q_svc leftover <<'EOF'
setsid bash -c 'trap "echo LEFTOVER got TERM >/dev/console; exit 0" TERM; while :; do sleep 0.05; done' &
EOF
q_svc escapee <<'EOF'
#%type: daemon
bash -c 'trap "" TERM; while :; do sleep 0.05; done' &
echo $! >/sys/fs/cgroup/cgroup.procs
echo $! >/run/escapee.pid
exec sleep 1000
EOF
q_file /sbin/hwclock 755 <<'EOF'
#!/bin/bash
while read -r k v; do
	[ "$k" = SigBlk: ] && blk=$v
done </proc/$$/status
read -r oom </proc/$$/oom_score_adj
echo "HWCLOCK $* blocked $blk oom $oom umask $(umask)" >/dev/console
EOF
q_file /etc/adjtime <<'EOF'
0.0 0 0.0
0
LOCAL
EOF
q_check <<'EOF'
for s in s1 s2 s3 p1 p2 lone stubborn again leftover escapee; do
	st_is $s up
done
check "the escaped process left the service cgroup" grep -qx "0::/" /proc/$(cat /run/escapee.pid)/cgroup
# halt and reboot requested during the poweroff are ignored, the sender outlives the checker
late_signals() {
	setsid bash -c 'trap "" TERM; kill -USR2 1; sleep 0.5; kill -USR1 1; kill -TERM 1' &
}
T_END=late_signals
EOF
q_boot
q_import
q_poweroff_ok
q_order "NOTE > s3: STOP s3" "NOTE > s2: STOP s2" "a dependent stops before its prerequisite"
q_order "NOTE > s2: STOP s2" "NOTE > s1: STOP s1" "and so on down the chain"
q_order "stubborn: still running 1000 ms after SIGTERM, killing it" "NOTE > s1: STOP s1" \
	"a prerequisite waits for a dependent that needs SIGKILL"
q_order "NOTE > p2: STOP p2" "NOTE > p1: STOP p1" "deps order edges are followed at shutdown too"
q_has "NOTE > lone: STOP lone" "an independent service is stopped"
q_has "LEFTOVER got TERM" "processes a oneshot left behind are signalled"
q_lacks "again: exited" "a restart: always daemon is not restarted during shutdown"
q_has "poweroff: sending SIGKILL to all processes" "a process outside every service that ignores SIGTERM is killed"
q_order "poweroff: sending SIGTERM to all processes" "poweroff: sending SIGKILL to all processes" \
	"SIGKILL follows SIGTERM to all processes"
q_has "HWCLOCK --systohc --localtime" "hwclock keeps local time when /etc/adjtime says LOCAL"
q_has "blocked 0000000000000000 oom 0 umask 0022" "hwclock runs with no signal blocked, oom_score_adj 0 and umask 022"
q_order "HWCLOCK" "poweroff: syncing and remounting read-only" "the clock is saved before the remount"
q_lacks "halt: now" "a halt signal during the shutdown is ignored"
q_lacks "reboot: now" "a reboot signal during the shutdown is ignored"

if [ -z "$Q_QUIET" ]; then
	t_s3=$(sed -n 's/.*STOP s3 \([0-9.]*\).*/\1/p' "$Q/console.log")
	t_lone=$(sed -n 's/.*STOP lone \([0-9.]*\).*/\1/p' "$Q/console.log")
	gap=$(awk -v a="$t_s3" -v b="$t_lone" 'BEGIN { d = (a - b) * 1000; if (d < 0) d = -d; printf "%d", d }')
	t_ok $((gap > 500 * Q_SCALE)) "shutdown: independent branches stop in parallel ($gap ms apart)"
else
	t_skip "shutdown: independent branches stop in parallel, not on a quiet console"
fi

# the active vt moves to tty1 as soon as the shutdown begins, README 7.2
# the checker ignores SIGTERM so it outlives the ordered stop long enough to watch the switch
q_new shutdown-vt
q_svc check <<'EOF'
#%type: daemon
#%onfail: warn
#%start-tries: 1
#%stop-timeout: 3s
. /t/lib.sh
vt_active() {
	[ "$(cat /sys/class/tty/tty0/active 2>/dev/null)" = "$1" ]
}
if [ -e /sys/class/tty/tty0/active ] && chvt 3 2>/dev/null && wait_for 2000 vt_active tty3; then
	trap '' TERM
	kill -USR2 1
	check "a poweroff switches the active vt to tty1 before stopping anything" wait_for 3000 vt_active tty1
	T_END=none
else
	skip "a poweroff switches the active vt to tty1 before stopping anything, the guest has no virtual terminals"
fi
t_end
EOF
q_boot
q_import
q_poweroff_ok

# the ordered stop ends 30 s after it began, whatever stop-timeout says
q_new shutdown-deadline
Q_TIMEOUT=90
q_svc base <<'EOF'
#%type: daemon
trap 'echo "STOP base"; exit 0' TERM
while :; do sleep 0.05; done
EOF
q_svc hold <<'EOF'
#%type: daemon
#%depon: base
#%stop-timeout: 60s
trap '' TERM
while :; do sleep 0.05; done
EOF
q_check <<'EOF'
st_is base up
st_is hold up
EOF
q_boot
q_import
q_poweroff_ok
q_has "WARN > shutdown: 2 services did not stop in order" "the ordered stop gives up on a service within its stop-timeout"
q_lacks "hold: still running" "before the stop-timeout of 60 s runs out"
q_order "did not stop in order" "poweroff: sending SIGTERM to all processes" "then every process gets SIGTERM"
q_order "poweroff: sending SIGTERM to all processes" "STOP base" \
	"which reaches the prerequisite the ordered stop never signalled"
q_has "poweroff: sending SIGKILL to all processes" "and SIGKILL follows for what ignores it"
if [ -z "$Q_QUIET" ]; then
	at() {
		q_log | grep -F -m1 -- "$1" | sed -E 's/^\[ *([0-9]+\.[0-9]+)\].*/\1/'
	}
	gap=$(awk -v a="$(at 'shutdown: stopping')" -v b="$(at 'did not stop in order')" 'BEGIN { printf "%d", (b - a) * 1000 }')
	t_ok $((gap < 30000 || gap > 30000 + 2000 * Q_SCALE)) "shutdown-deadline: the ordered stop ends after 30 s ($gap ms)"
else
	t_skip "shutdown-deadline: the ordered stop ends after 30 s, not on a quiet console"
fi

q_new shutdown-hwclock
q_file /sbin/hwclock 755 <<'EOF'
#!/bin/bash
echo "HWCLOCK $*" >/dev/console
exec sleep 100
EOF
q_check <<'EOF'
ok 0 "booted"
EOF
q_boot
q_import
q_poweroff_ok
q_has "HWCLOCK --systohc --utc" "without /etc/adjtime the hardware clock is UTC"
q_has "WARN > shutdown: hwclock did not exit in 5 s, killing it" "a hanging hwclock is killed after 5 s"
t_done
