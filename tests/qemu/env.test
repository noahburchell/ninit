# the execution environment of a service, README 3.8
# descriptors are listed by a child writing to a file, a pipeline would list the pipe ends of the shell

. "$top_srcdir/tests/lib.sh"
. "$top_srcdir/tests/qemu/lib.sh"
q_require

probe_services() {
	q_svc probe <<'EOF'
#%type: daemon
#%notify: 5
o=/run/probe
mkdir -p $o
tr '\0' '\n' </proc/$$/environ >$o/environ
echo "$0" >$o/argv0
umask >$o/umask
pwd >$o/cwd
ls /proc/$$/fd >$o/fds.raw
sort -n $o/fds.raw | tr '\n' ' ' >$o/fds
readlink /proc/$$/fd/0 >$o/stdin
readlink /proc/$$/fd/1 >$o/stdout
readlink /proc/$$/fd/2 >$o/stderr
readlink /proc/$$/fd/5 >$o/notify
ulimit -Sn >$o/nofile_soft
ulimit -Hn >$o/nofile_hard
cat /proc/$$/oom_score_adj >$o/oom
cat /proc/$$/cgroup >$o/cgroup
cat /proc/$$/stat >$o/stat
echo $$ >$o/pid
grep -E '^(SigBlk|SigIgn|CapEff|CapBnd|Uid|Gid)' /proc/self/status >$o/status
echo >&5
exec 5>&- sleep 100000
EOF
	q_svc plain <<'EOF'
o=/run/plain
mkdir -p $o
ls /proc/$$/fd >$o/fds.raw
sort -n $o/fds.raw | tr '\n' ' ' >$o/fds
tr '\0' '\n' </proc/$$/environ >$o/environ
echo run >>$o/runs
EOF
	q_svc nonotify <<'EOF'
#%type: daemon
ls /proc/$$/fd >/run/nonotify.raw
sort -n /run/nonotify.raw | tr '\n' ' ' >/run/nonotify.fds
exec sleep 100000
EOF
}

q_new env
probe_services
q_file /etc/locale.conf <<'EOF'
# system locale
LANG="de_DE.UTF-8"
this line is not an assignment
LC_TIME='en_GB.UTF-8'   # comment
LC_MESSAGES = C
FOO=bar
EOF
q_check <<'EOF'
st_is probe up
st_is plain up
st_is nonotify up
o=/run/probe
is "$(cat $o/environ)" "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/
TERM=linux
LANG=de_DE.UTF-8
LC_TIME=en_GB.UTF-8
LC_MESSAGES=C" "the environment is PATH, HOME, TERM and the locale, nothing else"
is "$(cat $o/argv0)" probe "\$0 is the service name"
is "$(cat $o/umask)" 0022 "the umask is 022"
is "$(cat $o/cwd)" / "the working directory is /"
is "$(cat $o/fds)" "0 1 2 5 " "only 0, 1, 2 and the notify fd are open"
is "$(cat $o/stdin)" /dev/null "stdin is /dev/null"
like "$(cat $o/stdout)" '^pipe:\[[0-9]+\]$' "stdout is a pipe"
is "$(cat $o/stderr)" "$(cat $o/stdout)" "stderr is the same pipe"
like "$(cat $o/notify)" '^pipe:\[[0-9]+\]$' "the notify fd is a pipe"
ok $([ "$(cat $o/notify)" != "$(cat $o/stdout)" ]; echo $?) "the notify pipe is not the output pipe"
is "$(cat $o/nofile_soft)" 1024 "RLIMIT_NOFILE is 1024 soft"
is "$(cat $o/nofile_hard)" 524288 "RLIMIT_NOFILE is 524288 hard"
is "$(cat $o/oom)" 0 "oom_score_adj is 0"
idx=$(idx_of probe)
is "$(cat $o/cgroup)" "0::/ninit.services/svc-$idx" "the service runs in ninit.services/svc-N, N its index"
read -r pid comm state ppid pgrp session tty rest <$o/stat
is "$ppid" 1 "the parent is pid 1"
is "$session" "$(cat $o/pid)" "the service leads a new session"
is "$pgrp" "$(cat $o/pid)" "and its own process group"
is "$tty" 0 "and has no controlling terminal"
has "$(cat $o/status)" "SigBlk:	0000000000000000" "no signal is blocked"
has "$(cat $o/status)" "SigIgn:	0000000000000000" "no signal is ignored"
cape=$(awk '/^CapEff/ { print $2 }' $o/status)
capb=$(awk '/^CapBnd/ { print $2 }' $o/status)
is "$cape" "$capb" "every capability is effective"
has "$(cat $o/status)" "Uid:	0	0	0	0" "uid 0"
has "$(cat $o/status)" "Gid:	0	0	0	0" "gid 0"
is "$(cat /run/plain/fds)" "0 1 2 " "a oneshot has only 0, 1 and 2"
is "$(cat /run/nonotify.fds)" "0 1 2 " "a daemon without notify has only 0, 1 and 2"
log_has "WARN > locale: /etc/locale.conf has a line that is not name=value" "an invalid locale.conf line is warned about"
lacks "$(cat $o/environ)" FOO "variables that are not locale variables are ignored"

# a service started from a shell does not inherit the environment of the shell
export LEAK=yes
ninitctl restart plain >/dev/null
is "$(wc -l </run/plain/runs)" 2 "restart runs a oneshot again"
lacks "$(cat /run/plain/environ)" LEAK "a service started by ninitctl gets ninit's environment"
EOF
q_boot
q_import
q_poweroff_ok

q_new env-nolocale
probe_services
q_check <<'EOF'
st_is probe up
has "$(cat /run/probe/environ)" "LANG=C.UTF-8" "without /etc/locale.conf services get LANG=C.UTF-8"
is "$(grep -c '^LC_' /run/probe/environ)" 0 "and no other locale variable"
EOF
q_boot
q_import
q_poweroff_ok

t_done
