# containment, README 3.8 and 5.3

. "$top_srcdir/tests/lib.sh"
. "$top_srcdir/tests/qemu/lib.sh"
q_require

q_new cgroup
q_svc daemon <<'EOF'
#%type: daemon
sleep 1000 &
echo $! >/run/daemon.child
exec sleep 1000
EOF
q_svc lefty <<'EOF'
sleep 1000 &
echo $! >/run/lefty.child
EOF
q_svc hard <<'EOF'
#%type: daemon
#%stop-timeout: 300ms
bash -c 'trap "" TERM; exec sleep 1000' &
echo $! >/run/hard.child
exec sleep 1000
EOF
q_svc failing <<'EOF'
#%start-tries: 1
sleep 1000 &
echo $! >/run/failing.child
exit 1
EOF
q_svc orphans <<'EOF'
for k in 1 2 3 4 5; do
	( sleep 0.3 & )
done
EOF
q_svc probed <<'EOF'
#%type: daemon
#%notify: 3
( { sleep 0.2; echo >&3; } & )
exec sleep 1000
EOF
q_svc escaper <<'EOF'
echo $$ >/run/escaper.pid
( exec setsid sleep 1000 ) &
echo $! >/run/escaper.child
EOF
q_svc dep <<'EOF'
#%depon: escaper
:
EOF
q_check <<'EOF'
st_is daemon up
st_is lefty up
st_is hard up
st_is failing failed
st_is orphans up
st_is probed up

cg=$(cg_of "$(idx_of daemon)")
procs=$(cat $cg/cgroup.procs)
has "$procs" "$(pid_of daemon)" "the main process is in the service cgroup"
has "$procs" "$(cat /run/daemon.child)" "and so are its children"

lcg=$(cg_of "$(idx_of lefty)")
child=$(cat /run/lefty.child)
has "$(cat $lcg/cgroup.procs)" "$child" "a process a oneshot leaves behind stays in its cgroup"
is "$(st lefty)" up "the oneshot is up"
out=$(ninitctl stop lefty)
is "$?:$out" "0:lefty stopped" "stop signals what the oneshot left behind"
check "the leftover process is gone" wait_for 2000 test ! -e /proc/$child
check "an empty cgroup is removed" wait_for 2000 test ! -d "$lcg"
is "$(st lefty)" down "the stopped oneshot is down"

# the process group of a oneshot that has exited is empty once its leftover calls setsid
st_is escaper up
st_is dep up
old=$(cat /run/escaper.pid)
esc=$(cat /run/escaper.child)
pgrp_is() {
	[ "$(cut -d' ' -f5 /proc/$1/stat 2>/dev/null)" = "$2" ]
}
check "the leftover of escaper leads a process group of its own" wait_for 2000 pgrp_is "$esc" "$esc"
victim=
if [ -w /proc/sys/kernel/ns_last_pid ]; then
	for try in 1 2 3 4 5 6 7 8; do
		echo $((old - 1)) >/proc/sys/kernel/ns_last_pid
		setsid sleep 1000 &
		[ "$!" = "$old" ] && { victim=$!; break; }
		kill $!
	done
fi
if [ -n "$victim" ]; then
	check "another process leads a process group with the old number" wait_for 2000 pgrp_is "$victim" "$old"
	out=$(ninitctl stop escaper)
	is "$?:$out" "0:escaper stopped" "stop of a oneshot whose process group is gone succeeds"
	check "and leaves the process now holding that number alone" test -e /proc/$victim
	kill $victim
else
	skip "another process leads a process group with the old number, ns_last_pid cannot be set"
	out=$(ninitctl stop escaper)
	is "$?:$out" "0:escaper stopped" "stop of a oneshot whose process group is gone succeeds"
	skip "and leaves the process now holding that number alone, ns_last_pid cannot be set"
fi
check "the leftover that left the process group is gone" wait_for 2000 test ! -e /proc/$esc
is "$(st escaper)" down "the stopped oneshot is down"
out=$(ninitctl start dep 2>&1)
is "$?:$out" "1:ninitctl: dep waiting on a prerequisite" "and its dependents see it go down"
out=$(ninitctl start escaper)
is "$?:$out" "0:escaper up" "a start brings it back"
st_is dep up 5000 "and its dependent follows"

hchild=$(cat /run/hard.child)
out=$(ninitctl stop hard)
is "$?:$out" "0:hard stopped after SIGKILL" "a child ignoring SIGTERM keeps the service from stopping until SIGKILL"
check "SIGKILL reaches every process in the cgroup" test ! -e /proc/$hchild

check "a failed start kills what the attempt left behind" wait_for 2000 test ! -e /proc/$(cat /run/failing.child)

sleep 0.6
zombies=$(grep -l '^State:.*Z' /proc/[0-9]*/status 2>/dev/null | wc -l)
is "$zombies" 0 "orphans reparented to pid 1 are reaped"
is "$(grep -l "^PPid:[[:space:]]*$(pid_of probed)\$" /proc/[0-9]*/status 2>/dev/null | wc -l)" 0 \
	"a readiness probe started as the examples start it is no child of its daemon"
EOF
q_boot
q_import
q_poweroff_ok
t_done
